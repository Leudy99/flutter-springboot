            "description": "Usa el id que quedó guardado al registrarte (`userId`). No tienes que escribirlo."
          }
        },
        {
          "name": "Crear usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const enviado = JSON.parse(pm.request.body.raw);",
                  "pm.test(\"Guarda el email que enviaste\", () => pm.expect(body.email).to.eql(enviado.email));",
                  "pm.test(\"NO devuelve la contraseña\", () => pm.expect(body).to.not.have.property(\"password\"));",
                  "pm.collectionVariables.set(\"createdId\", body.id);",
                  "pm.environment.set(\"createdId\", body.id);",
                  "console.log(\"createdId guardado:\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Perez\",\n  \"email\": \"ana@test.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Segundo usuario. Edita sus datos en la pestana **Body**.\n\nSu id queda en la variable `createdId`.\n\nSi cambias el email aqui, cambialo tambien en el paso 6."
          }
        },
        {
          "name": "Actualizar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const enviado = JSON.parse(pm.request.body.raw);",
                  "pm.test(\"El nombre quedó actualizado\", () => pm.expect(pm.response.json().name).to.eql(enviado.name));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
