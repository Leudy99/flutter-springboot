              "raw": "{\n  \"name\": \"\",\n  \"email\": \"no-es-un-email\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "Datos malos a propósito: nombre vacío, email sin formato y contraseña corta. Aquí los valores SÍ van fijos, porque el objetivo es que fallen."
