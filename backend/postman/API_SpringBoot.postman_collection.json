                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "999999"
              ]
            }
          }
        },
        {
          "name": "400 - Datos inválidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400 Bad Request\", () => pm.response.to.have.status(400));",
